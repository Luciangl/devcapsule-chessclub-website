---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';

const allNews = await getCollection('news');

// Two-year cutoff date relative to today
const twoYearsAgo = new Date();
twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);

// Filter current articles (< 2 years old)
const currentArticles = allNews
  .filter(item => new Date(item.data.date) >= twoYearsAgo)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const archivedCount = allNews.filter(item => new Date(item.data.date) < twoYearsAgo).length;
---

<Layout title="Noutăți & Evenimente Recente - ACS Smart Galați" description="Turnee, rezultate, anunțuri și viața clubului de șah ACS Smart Galați.">
  <div class="py-12 bg-slate-900/50 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Viața Clubului</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight mt-2">Noutăți &amp; Evenimente</h1>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto">
        Află cele mai proaspete știri despre turneele de blitz, cantonamentele de pregătire și rezultatele sportivilor noștri.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Archive Notice Banner -->
    <div class="mb-12 bg-slate-900/80 rounded-2xl border border-slate-800 p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📦</span>
        <div>
          <h2 class="text-sm font-bold text-slate-200">Cauți evenimente mai vechi de 2 ani?</h2>
          <p class="text-xs text-slate-400">Articolele și rapoartele anterioare sunt organizate cronologic în secțiunea Arhivă.</p>
        </div>
      </div>
      <a
        href="/arhiva"
        class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 hover:text-amber-300 text-xs font-bold border border-slate-700 transition-colors whitespace-nowrap"
      >
        Mergi la Arhivă ({archivedCount} articole) →
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentArticles.map(article => (
        <NewsCard
          title={article.data.title}
          date={article.data.date}
          summary={article.data.summary}
          slug={article.id}
          coverImage={article.data.cover_image}
          tags={article.data.tags}
          photosAlbumUrl={article.data.photos_album_url}
          photosCount={article.data.photos_count}
          hasLichess={Boolean(article.data.lichess_study_url)}
        />
      ))}
    </div>
  </div>
</Layout>
