  <!-- Coaches Spotlight (Trust & Authority) -->
  <section class="py-20 bg-slate-900/50 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Echipa Tehnică</span>
          <h2 class="text-3xl font-black text-slate-100 tracking-tight mt-1">Antrenori &amp; Maeștri FIDE</h2>
        </div>
        <a href="/antrenori" class="text-sm font-bold text-amber-400 hover:text-amber-300 flex items-center gap-1 transition-colors">
          Vezi toți cei 6 antrenori &amp; instructori →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Coach 1: Lucian Gilea -->
        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex items-center gap-5 shadow-lg">
          <img src="/images/coaches/lucian-gilea.svg" alt="Lucian Gilea" class="w-20 h-20 rounded-xl object-cover border border-slate-700 flex-shrink-0" />
          <div>
            <h4 class="font-black text-slate-100 text-lg">Lucian Gilea</h4>
            <p class="text-xs text-amber-400 font-semibold">Președinte &amp; Antrenor Principal</p>
            <p class="text-xs text-slate-400 mt-1">Maestru FIDE (Elo 2280), fondatorul clubului cu peste 10 ani de rezultate remarcabile.</p>
          </div>
        </div>

        <!-- Coach 2: Cristian Dăianu -->
        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex items-center gap-5 shadow-lg">
          <img src="/images/coaches/cristian-daianu.svg" alt="Cristian Dăianu" class="w-20 h-20 rounded-xl object-cover border border-slate-700 flex-shrink-0" />
          <div>
            <h4 class="font-black text-slate-100 text-lg">Cristian Dăianu</h4>
            <p class="text-xs text-amber-400 font-semibold">Instructor Sportiv &amp; Antrenor</p>
            <p class="text-xs text-slate-400 mt-1">Maestru FIDE (Elo 2166), specialist în strategie rațională și tactică competițională.</p>
          </div>
        </div>

        <!-- Coach 3: Robert Pîșu -->
        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 flex items-center gap-5 shadow-lg">
          <img src="/images/coaches/robert-pisu.svg" alt="Robert Pîșu" class="w-20 h-20 rounded-xl object-cover border border-slate-700 flex-shrink-0" />
          <div>
            <h4 class="font-black text-slate-100 text-lg">Robert Pîșu</h4>
            <p class="text-xs text-amber-400 font-semibold">Instructor Sportiv &amp; Antrenor</p>
            <p class="text-xs text-slate-400 mt-1">Maestru FIDE (Elo 2230), pasionat de formarea noilor generații de campioni.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent News & Tournaments (Decluttered view) -->
  <section class="py-20 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Viața Clubului</span>
          <h2 class="text-3xl font-black text-slate-100 tracking-tight mt-1">Ultimele Evenimente &amp; Turnee</h2>
        </div>
        <a href="/noutati" class="text-sm font-bold text-amber-400 hover:text-amber-300 flex items-center gap-1 transition-colors">
          Vezi toate noutățile ({currentNews.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredPost && (
          <NewsCard
            title={featuredPost.data.title}
            date={featuredPost.data.date}
            summary={featuredPost.data.summary}
            slug={featuredPost.id}
            coverImage={featuredPost.data.cover_image}
            tags={featuredPost.data.tags}
            photosAlbumUrl={featuredPost.data.photos_album_url}
            photosCount={featuredPost.data.photos_count}
            hasLichess={Boolean(featuredPost.data.lichess_study_url)}
          />
        )}

        {recentPosts.map(post => (
          <NewsCard
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            slug={post.id}
            coverImage={post.data.cover_image}
            tags={post.data.tags}
            photosAlbumUrl={post.data.photos_album_url}
            photosCount={post.data.photos_count}
            hasLichess={Boolean(post.data.lichess_study_url)}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Final High-Conversion Enrollment Banner -->
  <section class="py-16 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-600 text-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
        <div class="space-y-2 max-w-2xl">
