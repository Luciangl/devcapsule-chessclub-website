---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const twoYearsAgo = new Date();
twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);

// Filter current news (< 2 years old)
const currentNews = allNews
  .filter(item => new Date(item.data.date) >= twoYearsAgo)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featuredPost = currentNews.find(item => item.data.featured) || currentNews[0];
const recentPosts = currentNews.filter(item => item.id !== featuredPost?.id).slice(0, 2);
---

<Layout title="Clubul de Șah ACS Smart Galați - Cursuri Copii & Performanță">
  <!-- Exciting Hero Section with Immediate Lesson Finder -->
  <section class="relative overflow-hidden bg-slate-950 py-16 lg:py-24 border-b border-slate-800">
    <!-- Ambient chess glow -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
