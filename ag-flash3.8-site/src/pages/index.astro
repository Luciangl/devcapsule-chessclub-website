            <!-- Quick Form Button -->
            <div class="pt-2">
              <a
                href="https://forms.gle/smartgalati-inscriere"
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-3.5 px-4 rounded-xl text-center font-black text-slate-950 bg-amber-400 hover:bg-amber-300 text-sm transition-all shadow"
