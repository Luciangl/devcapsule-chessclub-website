                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400">Ghid Rapid</span>
                <h3 class="text-xl font-black text-slate-100">Ce grupă se potrivește?</h3>
              </div>
              <span class="text-2xl">🎯</span>
            </div>

            <!-- Program Selector items -->
            <div class="space-y-3">
              <a href="/cursuri#programe" class="block p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 hover:border-amber-500/50 hover:bg-slate-900/80 transition-all group">
