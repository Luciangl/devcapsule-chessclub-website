            </div>
            <div class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Antrenori &amp; Arbitri FIDE
            </div>
            <div class="flex items-center gap-2">
              <span class="text-amber-400">✓</span> Echipe de Divizia Națională
            </div>
          </div>
        </div>

        <!-- Quick Lesson Finder Card (What visitors care about!) -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 p-6 sm:p-8 rounded-3xl border-2 border-amber-500/40 shadow-2xl space-y-6 relative">
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
