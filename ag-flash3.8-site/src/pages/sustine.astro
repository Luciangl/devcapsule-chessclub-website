---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AntiSpamContact from '../components/AntiSpamContact.astro';

const page = await getEntry('pages', 'sustine');
if (!page) {
  throw new Error('Pagina sustine nu a fost găsită în colecție.');
}
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <div class="py-12 bg-slate-900/50 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Susține Șahul Gălățean</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight mt-2">{page.data.title}</h1>
      {page.data.subtitle && (
        <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto">{page.data.subtitle}</p>
      )}
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- 3 Steps Highlight Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm mb-3">1</div>
        <h4 class="font-bold text-slate-100 mb-1">Descarcă Formularul</h4>
        <p class="text-xs text-slate-400">Descarcă Formularul 230 precompletat cu datele asociației noastre.</p>
      </div>

      <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm mb-3">2</div>
        <h4 class="font-bold text-slate-100 mb-1">Completează &amp; Semnează</h4>
        <p class="text-xs text-slate-400">Trece datele tale de identificare. Nu trebuie să calculezi suma, o calculează ANAF.</p>
      </div>

      <div class="bg-slate-900/80 p-6 rounded-2xl border border-slate-800">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm mb-3">3</div>
        <h4 class="font-bold text-slate-100 mb-1">Trimite către Noi</h4>
        <p class="text-xs text-slate-400">Trimite scanat sau fizic, iar noi ne ocupăm de depunerea la organul fiscal competent.</p>
      </div>
    </div>

    <!-- Article Content -->
    <article class="bg-slate-900/80 p-8 sm:p-10 rounded-3xl border border-slate-800 shadow-xl">
      <div class="prose prose-invert prose-amber max-w-none text-slate-300 leading-relaxed text-base space-y-6">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs text-slate-400 block">Întrebări legate de sponsorizare:</span>
          <AntiSpamContact type="phone" value="0758 775 206" label="Telefon" />
        </div>
        <div>
          <AntiSpamContact type="email" value="smartsah@yahoo.com" label="Email" />
        </div>
      </div>
    </article>
  </div>
</Layout>
