---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AntiSpamContact from '../components/AntiSpamContact.astro';

const page = await getEntry('pages', 'contact');
if (!page) {
  throw new Error('Pagina contact nu a fost găsită în colecție.');
}
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <div class="py-12 bg-slate-900/50 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Hai la Șah!</span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight mt-2">{page.data.title}</h1>
      {page.data.subtitle && (
        <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto">{page.data.subtitle}</p>
      )}
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left Column: Fast Action Cards & Anti-Spam Contacts -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Online Enrollment Google Form Card -->
        <div id="inscriere" class="bg-slate-900 p-8 rounded-3xl border-2 border-amber-500/40 shadow-2xl">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-2xl mb-4">
            📝
          </div>
          <h2 class="text-2xl font-black text-slate-100 mb-2">Înscriere Cursuri</h2>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            Completează formularul online de înscriere pentru grupele de începători sau avansați. Te vom contacta în cel mai scurt timp pentru detalii și prima evaluare.
          </p>
          <a
            href="https://forms.gle/smartgalati-inscriere"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-4 px-6 rounded-xl font-bold text-center text-slate-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 transition-all shadow-lg hover:shadow-amber-500/25 text-base"
          >
            Deschide Formularul Google ↗
          </a>
        </div>

        <!-- Anti-Spam Contact Info Card -->
        <div class="bg-slate-900/90 p-8 rounded-3xl border border-slate-800 shadow-xl space-y-6">
          <h3 class="text-lg font-bold text-slate-100 border-b border-slate-800 pb-3 flex items-center gap-2">
            <span class="text-amber-500">🛡️</span> Date de Contact Protejate
          </h3>
          <p class="text-xs text-slate-400">
            Pentru a combate mesajele de tip spam, numărul și adresa de email sunt securizate împotriva roboților automați de colectare. Apasă pe oricare dintre ele pentru a le debloca și copia:
          </p>

          <div class="space-y-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
              <div class="text-xs text-slate-400 mb-1 font-semibold">Telefon Direct:</div>
              <AntiSpamContact type="phone" value="0758 775 206" />
            </div>

            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
              <div class="text-xs text-slate-400 mb-1 font-semibold">Email Club:</div>
              <AntiSpamContact type="email" value="smartsah@yahoo.com" />
            </div>

            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
              <div class="text-xs text-slate-400 mb-1 font-semibold">Locație &amp; Adresă:</div>
              <span class="text-slate-200 text-sm font-medium">Galați, jud. Galați, România</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Rich Markdown Content from content/pages/contact.md -->
      <div class="lg:col-span-7">
        <div class="bg-slate-900/80 p-8 sm:p-10 rounded-3xl border border-slate-800 shadow-xl">
          <div class="prose prose-invert prose-amber max-w-none text-slate-300 leading-relaxed text-base space-y-6">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
