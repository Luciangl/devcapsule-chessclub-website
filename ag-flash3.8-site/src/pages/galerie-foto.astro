---
import Layout from '../layouts/Layout.astro';
import galerieData from '../data/galerie.json';

const { albums, photos } = galerieData;
---

<Layout
  title="Galerie Foto - ACS Smart Galați"
  description="Galeria oficială foto a clubului de șah ACS Smart Galați: cantonamente, campionate naționale și festivaluri de șah."
  currentPath="/galerie-foto"
>
  <!-- Hero Section -->
  <div class="py-12 md:py-16 bg-slate-900/60 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-amber-500/5 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 font-bold text-xs uppercase tracking-wider">
        <span>📷</span> Imagini &amp; Amintiri
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight mt-3">
        Galerie Foto ACS Smart Galați
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Descoperă momentele memorabile din viața clubului: cantonamente montane de pregătire, participări la festivaluri de șah și triumfuri la campionatele naționale.
      </p>

      <!-- Stats Pills -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-300">
        <span class="px-3 py-1 rounded-lg bg-slate-800/80 border border-slate-700">
          📁 <strong>3</strong> Albume foto
        </span>
        <span class="px-3 py-1 rounded-lg bg-slate-800/80 border border-slate-700">
          📸 <strong>{photos.length}</strong> Fotografii de arhivă
        </span>
        <span class="px-3 py-1 rounded-lg bg-slate-800/80 border border-slate-700">
          ♟️ Inițiere &amp; Performanță
        </span>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Album Cards Overview -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-slate-200 mb-6 flex items-center gap-2">
        <span>🏆</span> Albume Oficiale
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {albums.map((album) => (
          <div
            class="album-card group bg-slate-900 rounded-2xl border border-slate-800 hover:border-amber-500/40 transition-all overflow-hidden shadow-lg flex flex-col cursor-pointer"
            data-target-album={album.id}
          >
            <div class="relative h-48 overflow-hidden bg-slate-950">
              <img
                src={album.coverSrc}
                alt={album.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs">
                <span class="px-2.5 py-0.5 rounded-full bg-amber-500/90 text-slate-950 font-black">
                  {album.year}
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-slate-900/80 text-slate-300 font-bold backdrop-blur-sm border border-slate-700">
                  {album.count} fotografii
                </span>
              </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-semibold text-amber-400 block mb-1">📍 {album.location}</span>
                <h3 class="text-lg font-bold text-slate-100 group-hover:text-amber-300 transition-colors line-clamp-1">
                  {album.shortTitle}
                </h3>
                <p class="mt-2 text-xs text-slate-400 line-clamp-2 leading-relaxed">
                  {album.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-semibold text-amber-400 group-hover:text-amber-300">
                <span>Explorează albumul</span>
                <span>→</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Filter Navigation Tabs -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 pb-4 border-b border-slate-800">
      <div class="flex items-center gap-2">
        <span class="text-sm font-bold text-slate-300">Filtrează după album:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-amber-500 text-slate-950 shadow-sm"
        >
          Toate ({photos.length})
        </button>
        {albums.map((album) => (
          <button
            type="button"
            data-filter={album.id}
            class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all"
          >
            {album.shortTitle} ({album.count})
          </button>
        ))}
      </div>
    </div>

    <!-- Photo Gallery Grid -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
    >
      {photos.map((photo, index) => (
        <div
          class="photo-item group relative rounded-xl overflow-hidden bg-slate-900 border border-slate-800/80 hover:border-amber-500/50 transition-all duration-300 aspect-[4/3] cursor-pointer shadow-md"
          data-album={photo.albumId}
          data-index={index}
          data-src={photo.src}
          data-title={photo.title}
          data-album-name={photo.albumTitle}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3.5">
            <span class="text-[10px] uppercase tracking-wider font-bold text-amber-400">
              {photo.albumShortTitle} • {photo.albumYear}
            </span>
            <p class="text-xs font-semibold text-slate-100 line-clamp-2 mt-0.5">
              {photo.title}
            </p>
            <div class="mt-2 flex items-center justify-between text-[11px] text-slate-400 font-medium pt-2 border-t border-slate-800/60">
              <span>🔍 Mărește fotografia</span>
              <span>#{index + 1}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State (hidden by default) -->
    <div id="empty-state" class="hidden py-16 text-center">
      <div class="text-4xl mb-3">♟️</div>
      <p class="text-base text-slate-300 font-bold">Nicio fotografie găsită pentru acest filtru.</p>
    </div>

    <!-- Call to Action Banner -->
    <div class="mt-16 bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/40 rounded-3xl border border-slate-800 p-8 sm:p-10 text-center shadow-xl">
      <h3 class="text-2xl sm:text-3xl font-black text-slate-100">
        Vrei ca și copilul tău să trăiască magia competițiilor de șah?
      </h3>
      <p class="mt-3 text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Înscrie-l la ACS Smart Galați! Antrenamente captivante cu maeștri FIDE, deplasări la turnee naționale și cantonamente de neuitat.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/cursuri"
          class="px-6 py-3 rounded-xl text-sm font-black text-slate-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 transition-all shadow-lg hover:shadow-amber-500/25"
        >
          🎓 Înscrie-te la Cursuri →
        </a>
        <a
          href="/contact"
          class="px-6 py-3 rounded-xl text-sm font-bold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-all"
        >
          📍 Contact &amp; Locație
        </a>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Vizualizator fotografie"
  >
    <!-- Top Bar Controls -->
    <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-slate-300 z-10">
      <div class="text-xs sm:text-sm font-semibold flex items-center gap-2">
        <span id="lightbox-counter" class="px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800">
          1 / 51
        </span>
        <span id="lightbox-album" class="hidden sm:inline text-amber-400 font-bold"></span>
      </div>
      <button
        id="lightbox-close"
        type="button"
        class="p-2.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white transition-colors"
        aria-label="Închide fereastra"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Prev Button -->
    <button
      id="lightbox-prev"
      type="button"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 p-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white transition-all shadow-xl z-10"
      aria-label="Fotografia anterioară"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Navigation Next Button -->
    <button
      id="lightbox-next"
      type="button"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 p-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-white transition-all shadow-xl z-10"
      aria-label="Fotografia următoare"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Main Image Display -->
    <div class="max-w-5xl max-h-[85vh] flex flex-col items-center justify-center p-2">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[72vh] object-contain rounded-xl shadow-2xl border border-slate-800/80 select-none transition-all duration-200"
      />
      <p id="lightbox-caption" class="mt-4 text-center text-sm sm:text-base font-semibold text-slate-200 max-w-2xl px-4">
      </p>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const photoItems = document.querySelectorAll('.photo-item');
    const albumCards = document.querySelectorAll('.album-card');
    const emptyState = document.getElementById('empty-state');

    // Lightbox elements
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img');
    const modalCaption = document.getElementById('lightbox-caption');
    const modalCounter = document.getElementById('lightbox-counter');
    const modalAlbum = document.getElementById('lightbox-album');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let visiblePhotos = Array.from(photoItems);
    let currentIdx = 0;

    // Filter logic
    function setFilter(filter) {
      filterButtons.forEach((btn) => {
        if (btn.getAttribute('data-filter') === filter) {
          btn.classList.add('active', 'bg-amber-500', 'text-slate-950');
          btn.classList.remove('bg-slate-900', 'text-slate-300', 'hover:bg-slate-800', 'hover:text-white', 'border', 'border-slate-800');
        } else {
          btn.classList.remove('active', 'bg-amber-500', 'text-slate-950');
          btn.classList.add('bg-slate-900', 'text-slate-300', 'hover:bg-slate-800', 'hover:text-white', 'border', 'border-slate-800');
        }
      });

      let count = 0;
      visiblePhotos = [];
      photoItems.forEach((item) => {
        const itemAlbum = item.getAttribute('data-album');
        if (filter === 'all' || itemAlbum === filter) {
          item.classList.remove('hidden');
          visiblePhotos.push(item);
          count++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (count === 0 && emptyState) {
        emptyState.classList.remove('hidden');
      } else if (emptyState) {
        emptyState.classList.add('hidden');
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        setFilter(filter);
      });
    });

    albumCards.forEach((card) => {
      card.addEventListener('click', () => {
        const target = card.getAttribute('data-target-album');
        if (target) {
          setFilter(target);
          document.getElementById('filter-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Lightbox modal logic
    function openLightbox(index) {
      if (!visiblePhotos.length) return;
      currentIdx = (index + visiblePhotos.length) % visiblePhotos.length;
      const targetItem = visiblePhotos[currentIdx];
      const src = targetItem.getAttribute('data-src') || '';
      const title = targetItem.getAttribute('data-title') || '';
      const album = targetItem.getAttribute('data-album-name') || '';

      modalImg.src = src;
      modalImg.alt = title;
      modalCaption.textContent = title;
      modalCounter.textContent = `${currentIdx + 1} / ${visiblePhotos.length}`;
      modalAlbum.textContent = album ? `• ${album}` : '';

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modalImg.src = '';
      document.body.style.overflow = '';
    }

    function showPrev() {
      openLightbox(currentIdx - 1);
    }

    function showNext() {
      openLightbox(currentIdx + 1);
    }

    // Attach click events to photo items
    photoItems.forEach((item) => {
      item.addEventListener('click', () => {
        const vIdx = visiblePhotos.indexOf(item);
        if (vIdx !== -1) {
          openLightbox(vIdx);
        }
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Close when clicking modal backdrop
    modal?.addEventListener('click', (e) => {
      if (e.target === modal || e.target.parentElement === modal) {
        closeLightbox();
      }
    });

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });
  });
</script>
