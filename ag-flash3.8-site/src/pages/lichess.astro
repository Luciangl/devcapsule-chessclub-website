---
import Layout from '../layouts/Layout.astro';
import LichessEmbed from '../components/LichessEmbed.astro';
---

<Layout title="Integrare Lichess & Resurse Șah - ACS Smart Galați" description="Studiu interactiv de șah, partide analizate și integrare cu Lichess.org la ACS Smart Galați.">
  <div class="py-12 bg-slate-900/50 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase mb-2">
        <span>♟️ Tehnologie &amp; Antrenament</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight">Integrare Lichess.org</h1>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto">
        Folosim platforme open-source de top pentru analiza partidelor, transmiterea meciurilor în direct și teme tactice pentru elevii clubului.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <!-- Showcase 1: Interactive Lichess Study -->
    <section class="bg-slate-900/80 p-8 rounded-3xl border border-slate-800 shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-amber-400">Lecție Demonstrativă</span>
          <h2 class="text-2xl font-black text-slate-100 mt-1">Studiu Interactiv: Capcane Tipice în Deschideri</h2>
          <p class="text-sm text-slate-400 mt-1">
            Poți muta piesele pe tablă, explora variante alternative și citi comentariile antrenorilor noștri.
          </p>
        </div>
        <a 
          href="https://lichess.org/study" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-amber-400 border border-slate-700 text-xs font-bold transition-all whitespace-nowrap"
        >
          Explorează Studii pe Lichess ↗
        </a>
      </div>

      <!-- The embedded study -->
      <LichessEmbed 
        studyUrl="https://lichess.org/study/embed/kYwKjNq0/1k1oZ6XG?theme=brown&bg=dark" 
        title="ACS Smart Galați - Studiu Deschideri & Tactică"
        height={480}
      />
    </section>

    <!-- Showcase 2: Lichess TV / Live Broadcast -->
    <section class="bg-slate-900/80 p-8 rounded-3xl border border-slate-800 shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-amber-400">Șah la Nivel Înalt</span>
          <h2 class="text-2xl font-black text-slate-100 mt-1">Lichess TV: Partide de Mari Maeștri în Direct</h2>
          <p class="text-sm text-slate-400 mt-1">
            Urmărește în timp real partidele jucate la cele mai mari mese din lume.
          </p>
        </div>
      </div>

      <div class="rounded-2xl overflow-hidden border border-slate-700/80 bg-slate-950 shadow-2xl">
        <iframe 
          src="https://lichess.org/tv/frame?theme=brown&bg=dark" 
          width="100%" 
          height="400" 
          class="w-full border-0 block"
          loading="lazy"
          title="Lichess TV Live"
        ></iframe>
      </div>
    </section>

    <!-- Guide for Coaches: How to Embed -->
    <section class="p-8 rounded-3xl bg-slate-950 border border-slate-800 text-slate-300">
      <h3 class="text-lg font-bold text-slate-100 mb-3 flex items-center gap-2">
        <span>💡</span> Ghid Rapid pentru Antrenori: Cum adaugi un studiu într-un articol?
      </h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-4">
        Pentru a adăuga un studiu Lichess într-un articol nou de pe site, este suficient să adaugi o singură linie în antetul fișierului Markdown:
      </p>
      <pre class="bg-slate-900 p-4 rounded-xl text-xs font-mono text-amber-300 border border-slate-800 overflow-x-auto">
---
title: "Analiza Turneului de Blitz"
date: 2025-02-09
lichess_study_url: "https://lichess.org/study/embed/kYwKjNq0/1k1oZ6XG?theme=brown&bg=dark"
---
      </pre>
      <p class="text-xs text-slate-400 mt-3">
        Site-ul va crea automat tabla interactivă direct în pagină, fără ca antrenorul să scrie cod HTML!
      </p>
    </section>
  </div>
</Layout>
