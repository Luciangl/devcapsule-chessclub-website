---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const page = await getEntry('pages', 'cursuri');
if (!page) {
  throw new Error('Pagina cursuri nu a fost găsită în colecție.');
}
const { Content } = await render(page);
---

<Layout title="Cursuri de Șah Copii & Înscrieri - ACS Smart Galați" description="Înscrieri la cursurile de șah pentru copii de la 5 ani, intermediari și avansați la ACS Smart Galați. Prima ședință gratuită!">
  <!-- Hero Header -->
  <div class="relative py-16 md:py-20 bg-slate-900/60 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider">
        <span>🏆 Prima Ședință de Evaluare Gratuită</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-100 tracking-tight leading-tight">
        Cursuri de Șah în Galați
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Descoperă bucuria șahului! Dezvoltăm concentrarea, gândirea logică și încrederea în sine pentru copii începând de la vârsta de 5 ani.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://forms.gle/smartgalati-inscriere"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-xl font-black text-slate-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 shadow-xl hover:shadow-amber-500/25 transition-all text-base"
        >
          Înscrie Copilul Acum (2 minute) →
        </a>
        <a
          href="#programe"
          class="w-full sm:w-auto px-6 py-4 rounded-xl font-bold text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-700 transition-all text-base"
        >
          Vezi Grupele &amp; Orarul ↓
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- 3 Steps Quick Overview -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs uppercase font-bold tracking-widest text-amber-400">Proces Simplu</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-100 mt-1">Cum începi în 3 pași rapizi</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-slate-900/90 p-8 rounded-2xl border border-slate-800 relative hover:border-amber-500/40 transition-all shadow-xl">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-xl font-black mb-4">
            1
          </div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">Completezi Formularul</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Durează sub 2 minute. Ne lași datele de contact și câteva detalii despre copil (vârstă, experiență).
          </p>
        </div>

        <div class="bg-slate-900/90 p-8 rounded-2xl border border-slate-800 relative hover:border-amber-500/40 transition-all shadow-xl">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-xl font-black mb-4">
            2
          </div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">Ședință Gratuită de Evaluare</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Te contactăm pentru a programa o primă ședință în care antrenorul identifică nivelul optim și compatibilitatea cu grupa.
          </p>
        </div>

        <div class="bg-slate-900/90 p-8 rounded-2xl border border-slate-800 relative hover:border-amber-500/40 transition-all shadow-xl">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-xl font-black mb-4">
            3
          </div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">Prima Mutare pe Tablă!</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Copilul începe cursurile într-o grupă mică (6-10 elevi), cu atenție individualizată și materiale didactice incluse.
          </p>
        </div>
      </div>
    </div>

    <!-- Grupe de Vârstă Interactive Cards -->
    <div id="programe" class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase font-bold tracking-widest text-amber-400">Niveluri de Pregătire</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-100 mt-1">Alege grupa potrivită pentru copilul tău</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1: Inițiere -->
        <div class="bg-slate-900/80 rounded-3xl border border-slate-800 p-8 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-2xl">
          <div>
            <div class="inline-flex px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-bold mb-4">
              Vârstă: 5 – 8 Ani
            </div>
            <h3 class="text-2xl font-black text-slate-100 mb-2">Pionul Curajos</h3>
            <p class="text-xs text-amber-400 font-semibold mb-4">Nivel: Debutant &amp; Inițiere</p>
            <ul class="text-sm text-slate-300 space-y-3 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Regulile jocului prin povești și jocuri
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Noțiuni de mat simplu și siguranța regelui
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Dezvoltarea răbdării și a atenției
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Ședințe dinamice de 60 de minute
              </li>
            </ul>
          </div>
          <a
            href="https://forms.gle/smartgalati-inscriere"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-3 px-4 rounded-xl text-center font-bold text-xs bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 transition-colors"
          >
            Înscrie la Inițiere →
          </a>
        </div>

        <!-- Card 2: Intermediari (Featured) -->
        <div class="bg-slate-900 rounded-3xl border-2 border-amber-500/60 p-8 flex flex-col justify-between shadow-2xl relative">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-amber-500 text-slate-950 font-black text-xs uppercase tracking-wider shadow">
            Cea Mai Populară
          </div>
          <div>
            <div class="inline-flex px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-bold mb-4 mt-2">
              Vârstă: 8 – 14 Ani
            </div>
            <h3 class="text-2xl font-black text-slate-100 mb-2">Cavalerii Tacticii</h3>
            <p class="text-xs text-amber-400 font-semibold mb-4">Nivel: Intermediar &amp; Club</p>
            <ul class="text-sm text-slate-300 space-y-3 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Motive tactice: furculiță, legare, atac dublu
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Principii strategice și controlul centrului
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Joc cu ceasul digital și scrierea mutărilor
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Ședințe de 90 de minute (teorie + turneu)
              </li>
            </ul>
          </div>
          <a
            href="https://forms.gle/smartgalati-inscriere"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-3.5 px-4 rounded-xl text-center font-bold text-xs bg-amber-500 hover:bg-amber-400 text-slate-950 transition-colors shadow-lg"
          >
            Înscrie la Intermediari →
          </a>
        </div>

        <!-- Card 3: Performanță -->
        <div class="bg-slate-900/80 rounded-3xl border border-slate-800 p-8 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-2xl">
          <div>
            <div class="inline-flex px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 text-xs font-bold mb-4">
              Lot Național
            </div>
            <h3 class="text-2xl font-black text-slate-100 mb-2">Maeștrii Performanței</h3>
            <p class="text-xs text-amber-400 font-semibold mb-4">Nivel: Competițional &amp; Divizie</p>
            <ul class="text-sm text-slate-300 space-y-3 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Repertoriu aprofundat de deschideri
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Calcul de variante și finaluri practice
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Analiză Stockfish, baze de date &amp; Lichess
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500">✓</span> Pregătire pentru Campionatele Naționale
              </li>
            </ul>
          </div>
          <a
            href="/contact"
            class="block w-full py-3 px-4 rounded-xl text-center font-bold text-xs bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 transition-colors"
          >
            Solicită Selecție Lot →
          </a>
        </div>
      </div>
    </div>

    <!-- Full Details from content/pages/cursuri.md -->
    <div class="bg-slate-900/80 p-8 sm:p-12 rounded-3xl border border-slate-800 shadow-xl mb-16">
      <div class="prose prose-invert prose-amber max-w-none text-slate-300 leading-relaxed text-base space-y-6">
        <Content />
      </div>
    </div>

    <!-- Final Call to Action -->
    <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-3xl p-8 sm:p-12 text-slate-950 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight">Pregătit pentru prima partidă?</h3>
        <p class="text-sm sm:text-base font-semibold text-slate-900 max-w-xl">
          Locurile în grupe sunt limitate la maximum 8-10 copii pentru a asigura calitatea predării. Rezervă locul acum!
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="https://forms.gle/smartgalati-inscriere"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 rounded-xl font-black bg-slate-950 text-white hover:bg-slate-900 transition-all shadow-xl text-center text-sm"
        >
          Formular de Înscriere ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
