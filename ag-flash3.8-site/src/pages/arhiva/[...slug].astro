---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LichessEmbed from '../../components/LichessEmbed.astro';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  const twoYearsAgo = new Date();
  twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);

  const archivedArticles = allNews.filter(item => new Date(item.data.date) < twoYearsAgo);

  return archivedArticles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formattedDate = new Intl.DateTimeFormat('ro-RO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.date);
---

<Layout title={`[Arhivă] ${article.data.title}`} description={article.data.summary}>
  <!-- Archive Notice Ribbon -->
  <div class="bg-slate-900 border-b border-amber-500/30 py-2.5 px-4 text-center text-xs font-semibold text-amber-400">
    <span>📦 Acest articol face parte din arhiva istorică a clubului (eveniment petrecut acum mai mult de 2 ani).</span>
  </div>

  <div class="py-12 bg-slate-900/50 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <a href="/arhiva" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 transition-colors">
          ← Înapoi la Arhiva Istorică
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 mb-3">
        <span class="px-2.5 py-1 rounded-full bg-slate-800 border border-slate-700 text-amber-400 font-semibold">
          📅 {formattedDate}
        </span>
        <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
          📦 Arhivat
        </span>
        {article.data.tags.map(tag => (
          <span class="px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 uppercase text-[10px] tracking-wider">
            #{tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-100 tracking-tight leading-tight">
        {article.data.title}
      </h1>

      <p class="mt-4 text-lg text-slate-300 leading-relaxed font-medium">
        {article.data.summary}
      </p>
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {article.data.cover_image && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 aspect-[16/9] shadow-2xl">
        <img 
          src={article.data.cover_image} 
          alt={article.data.title} 
          class="w-full h-full object-cover grayscale-[30%]" 
        />
      </div>
    )}

    {article.data.photos_album_url && (
      <div class="mb-10 p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-slate-800 text-amber-400 flex items-center justify-center text-2xl">
            📷
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-100">Album Foto de Arhivă</h2>
            <p class="text-xs text-slate-400">
              {article.data.photos_count ? `${article.data.photos_count} fotografii arhivate sunt disponibile pe Google Photos.` : 'Fotografiile din arhivă sunt disponibile pe Google Photos.'}
            </p>
          </div>
        </div>
        <a
          href={article.data.photos_album_url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 text-xs whitespace-nowrap"
        >
          Vezi Albumul ↗
        </a>
      </div>
    )}

    <div class="prose prose-invert prose-amber max-w-none text-slate-300 leading-relaxed text-base sm:text-lg space-y-6">
      <Content />
    </div>

    {article.data.lichess_study_url && (
      <div class="mt-10">
        <h2 class="text-xl font-bold text-slate-100 mb-2">♟️ Studiu &amp; Partidă de Arhivă</h2>
        <LichessEmbed studyUrl={article.data.lichess_study_url} />
      </div>
    )}

    <div class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
      <a href="/arhiva" class="text-sm font-bold text-amber-400 hover:text-amber-300 flex items-center gap-1">
        ← Înapoi la Arhivă
      </a>
      <a href="/noutati" class="text-sm text-slate-400 hover:text-slate-200">
        Vezi Știrile Recente →
      </a>
    </div>
  </article>
</Layout>
