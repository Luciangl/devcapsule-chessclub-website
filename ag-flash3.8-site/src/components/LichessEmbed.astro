---
interface Props {
  studyUrl?: string;
  gameId?: string;
  title?: string;
  height?: number;
}

const { 
  studyUrl, 
  gameId, 
  title = "Partidă / Studiu de Șah Lichess", 
  height = 450 
} = Astro.props;

let embedSrc = '';
if (studyUrl) {
  embedSrc = studyUrl;
} else if (gameId) {
  embedSrc = `https://lichess.org/embed/${gameId}?theme=brown&bg=dark`;
}
---

{embedSrc ? (
  <div class="my-6 rounded-2xl overflow-hidden border border-slate-700/80 bg-slate-900 shadow-2xl">
    <div class="px-4 py-3 bg-slate-800/90 border-b border-slate-700/60 flex items-center justify-between text-xs text-slate-300">
      <span class="flex items-center gap-2 font-medium text-amber-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
        </svg>
        {title}
      </span>
      <a href={embedSrc.replace('/embed', '')} target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 flex items-center gap-1 transition-colors">
        Deschide pe Lichess.org ↗
      </a>
    </div>
    
    <div class="relative w-full" style={`min-height: ${height}px`}>
      <iframe 
        src={embedSrc} 
        width="100%" 
        height={height} 
        loading="lazy"
        class="w-full border-0 block"
        title={title}
      ></iframe>
    </div>
  </div>
) : null}
