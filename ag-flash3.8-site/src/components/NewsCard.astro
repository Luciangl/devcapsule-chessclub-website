---
interface Props {
  title: string;
  date: Date;
  summary: string;
  slug: string;
  coverImage?: string;
  tags?: string[];
  photosAlbumUrl?: string;
  photosCount?: number;
  hasLichess?: boolean;
  isArchived?: boolean;
}

const {
  title,
  date,
  summary,
  slug,
  coverImage = '/images/news/2025-blitz-2.svg',
  tags = [],
  photosAlbumUrl,
  photosCount,
  hasLichess,
  isArchived = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('ro-RO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const href = isArchived ? `/arhiva/${slug}` : `/noutati/${slug}`;
---

<article class="group bg-slate-900/90 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-all duration-300 overflow-hidden flex flex-col shadow-lg hover:shadow-amber-500/10 hover:-translate-y-1">
  <!-- Card Header / Image -->
  <a href={href} class="relative block aspect-[16/9] overflow-hidden bg-slate-950">
    <img 
      src={coverImage} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
    
    <!-- Date Badge -->
    <div class="absolute top-3 left-3 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 text-amber-400 text-xs font-semibold px-3 py-1 rounded-full shadow">
      📅 {formattedDate}
    </div>

    {isArchived && (
      <div class="absolute top-3 right-3 bg-slate-800/90 text-slate-300 text-xs font-medium px-2.5 py-1 rounded-full border border-slate-700">
        📦 Arhivă
      </div>
    )}
  </a>

  <!-- Card Body -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Tags & Badges -->
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 3).map(tag => (
          <span class="text-[11px] font-medium uppercase tracking-wider px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700/50">
            #{tag}
          </span>
        ))}
        {photosAlbumUrl && (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/50 flex items-center gap-1">
            📷 {photosCount ? `${photosCount} poze` : 'Album'}
          </span>
        )}
        {hasLichess && (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-amber-950/80 text-amber-400 border border-amber-800/50 flex items-center gap-1">
            ♟️ Lichess
          </span>
        )}
      </div>

      <!-- Title -->
      <h3 class="text-xl font-bold text-slate-100 group-hover:text-amber-400 transition-colors line-clamp-2 mb-2 leading-snug">
        <a href={href}>
          {title}
        </a>
      </h3>

      <!-- Summary -->
      <p class="text-sm text-slate-400 line-clamp-3 leading-relaxed mb-4">
        {summary}
      </p>
    </div>

    <!-- Card Footer -->
    <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
      <a href={href} class="text-xs font-bold text-amber-400 group-hover:text-amber-300 flex items-center gap-1">
        Citește articolul
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>

      {photosAlbumUrl && (
        <a 
          href={photosAlbumUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-xs text-slate-400 hover:text-emerald-400 transition-colors flex items-center gap-1"
          title="Vezi albumul foto complet pe Google Photos"
        >
          Google Photos ↗
        </a>
      )}
    </div>
  </div>
</article>
