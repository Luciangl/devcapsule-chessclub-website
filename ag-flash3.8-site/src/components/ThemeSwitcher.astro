---
interface Props {
  className?: string;
  id?: string;
}

const { className = '', id = 'theme-switcher' } = Astro.props;

const themes = [
  { id: 'classic-dark', name: 'Classic Dark', desc: 'Ardezie & Aur', icon: '🌙', type: 'dark' },
  { id: 'solarized-light', name: 'Solarized Light', desc: 'Crem & Chihlimbar', icon: '☀️', type: 'light' },
  { id: 'nord-light', name: 'Nordic Clean', desc: 'Alb & Albastru Arctic', icon: '❄️', type: 'light' },
  { id: 'emerald-club', name: 'Tournament Green', desc: 'Tablă de Concurs & Fildeș', icon: '♟️', type: 'light' },
  { id: 'dracula', name: 'Midnight Blitz', desc: 'Dracula Contrast Înalt', icon: '⚡', type: 'dark' },
  { id: 'gruvbox', name: 'Gruvbox Warm', desc: 'Lemn Clasic & Nuc Retro', icon: '🪵', type: 'dark' },
];
---

<div class={`relative inline-block text-left theme-switcher-component ${className}`} id={id}>
  <button
    type="button"
    class="theme-toggle-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-700/80 bg-slate-900/90 text-slate-200 hover:text-amber-400 hover:border-amber-500/50 transition-all shadow-sm"
    aria-haspopup="true"
    aria-expanded="false"
    title="Schimbă tema de culori"
  >
    <span class="text-sm">🎨</span>
    <span class="current-theme-name font-medium hidden sm:inline">Temă</span>
    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- Theme Dropdown Menu -->
  <div
    class="theme-dropdown-menu hidden absolute right-0 mt-2 w-64 rounded-2xl bg-slate-900 border border-slate-700 shadow-2xl p-2 z-50 animate-in fade-in zoom-in-95 duration-100"
    role="menu"
  >
    <div class="px-3 py-2 text-[10px] font-extrabold uppercase tracking-widest text-slate-400 border-b border-slate-800 mb-1 flex items-center justify-between">
      <span>Alege Paleta de Culori (6)</span>
      <span class="text-amber-500 font-mono">CSS Live</span>
    </div>

    <div class="space-y-1">
      {themes.map(t => (
        <button
          type="button"
          data-theme-choice={t.id}
          class="theme-option-btn w-full text-left px-3 py-2 rounded-xl text-xs font-semibold flex items-center justify-between hover:bg-slate-800 transition-colors group"
          role="menuitem"
        >
          <div class="flex items-center gap-2.5">
            <span class="text-base">{t.icon}</span>
            <div>
              <div class="text-slate-200 group-hover:text-amber-400 font-bold transition-colors">{t.name}</div>
              <div class="text-[10px] text-slate-400 font-normal">{t.desc}</div>
            </div>
          </div>
          <span class="active-indicator hidden text-amber-400 font-black text-sm">✓</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function setupThemeSwitchers() {
    const components = document.querySelectorAll('.theme-switcher-component');
    const currentTheme = localStorage.getItem('chess_theme') || 'classic-dark';

    function updateActiveState(themeId: string) {
      document.querySelectorAll('.theme-option-btn').forEach(btn => {
        const choice = btn.getAttribute('data-theme-choice');
        const indicator = btn.querySelector('.active-indicator');
        if (choice === themeId) {
          btn.classList.add('bg-slate-800/80', 'border', 'border-amber-500/30');
          indicator?.classList.remove('hidden');
        } else {
          btn.classList.remove('bg-slate-800/80', 'border', 'border-amber-500/30');
          indicator?.classList.add('hidden');
        }
      });

      // Update button text if label exists
      document.querySelectorAll('.current-theme-name').forEach(label => {
        const matchingBtn = document.querySelector(`[data-theme-choice="${themeId}"]`);
        const nameText = matchingBtn?.querySelector('.text-slate-200')?.textContent;
        if (nameText) {
          label.textContent = nameText.split(' ')[0]; // E.g. "Solarized", "Classic", "Nordic"
        }
      });
    }

    components.forEach(comp => {
      const btn = comp.querySelector('.theme-toggle-btn');
      const menu = comp.querySelector('.theme-dropdown-menu');

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        menu?.classList.toggle('hidden');
      });

      comp.querySelectorAll('.theme-option-btn').forEach(opt => {
        opt.addEventListener('click', () => {
          const themeId = opt.getAttribute('data-theme-choice');
          if (themeId) {
            document.documentElement.setAttribute('data-theme', themeId);
            localStorage.setItem('chess_theme', themeId);
            updateActiveState(themeId);
            menu?.classList.add('hidden');
          }
        });
      });
    });

    // Close dropdown on outside click
    document.addEventListener('click', () => {
      document.querySelectorAll('.theme-dropdown-menu').forEach(m => m.classList.add('hidden'));
    });

    updateActiveState(currentTheme);
  }

  // Run immediately and on page navigation
  setupThemeSwitchers();
  document.addEventListener('astro:page-load', setupThemeSwitchers);
</script>
