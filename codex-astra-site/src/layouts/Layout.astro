---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { site } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const current = Astro.url.pathname;
const nav = [
  ['/despre-noi/', 'Clubul nostru'],
  ['/cursuri/', 'Cursuri de șah'],
  ['/noutati/', 'Noutăți'],
  ['/galerie-foto/', 'Galerie'],
  ['/contact/', 'Contact'],
];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#193e31" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(current, Astro.site)} />
    <meta
      property="og:title"
      content={
        title ? `${title} — ${site.name}` : `${site.name} — Următoarea mutare începe cu tine.`
      }
    />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title ? `${title} — ${site.name}` : `${site.name} — Următoarea mutare începe cu tine.`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Sari la conținut
    </a>
    <div class="topline">
      <div class="container">
        <span>
          GALAȚI, ROMÂNIA <span class="top-dot">·</span> DIN 2014
        </span>
        <a href="/sustine/">
          Fă o mutare bună. Susține clubul <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">
            <Mark />
          </span>
          <span>
            SMART <strong>GALAȚI</strong>
            <small>CLUB DE ȘAH</small>
          </span>
        </a>
        <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false">
          Meniu <span aria-hidden="true">☰</span>
        </button>
        <nav id="main-nav" aria-label="Navigare principală">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          ))}
          <a class="button nav-cta" href={site.enrollmentUrl}>
            Hai la șah <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <section class="join-band">
      <div class="container join-inner">
        <div>
          <span class="eyebrow">O TABLĂ. 64 DE PĂTRATE. INFINITE POSIBILITĂȚI.</span>
          <h2>
            Locul tău la masă
            <br />
            te așteaptă.
          </h2>
        </div>
        <div>
          <p>
            Prima mutare? Să ne cunoaștem.
            <br />
            De restul ne ocupăm împreună.
          </p>
          <a class="button light" href={site.enrollmentUrl}>
            Înscrie-te la cursuri <span aria-hidden="true">↗</span>
          </a>
        </div>
        <span class="join-piece" aria-hidden="true">
          ♞
        </span>
      </div>
    </section>
    <footer>
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark">
              <Mark />
            </span>
            <span>
              SMART <strong>GALAȚI</strong>
              <small>CLUB DE ȘAH</small>
            </span>
          </a>
          <p>
            Creștem caractere.
            <br />
            Mutare cu mutare.
          </p>
        </div>
        <div>
          <h2>Descoperă clubul</h2>
          <a href="/despre-noi/">Povestea noastră</a>
          <a href="/antrenori/">Antrenori</a>
          <a href="/echipe/">Echipe & sportivi</a>
          <a href="/performante/">Performanțe</a>
        </div>
        <div>
          <h2>Intră în joc</h2>
          <a href="/cursuri/">Cursuri de șah</a>
          <a href="/lichess/">Colțul de șah</a>
          <a href="/galerie-foto/">Galerie foto</a>
          <a href="/arhiva/">Arhiva clubului</a>
        </div>
        <div>
          <h2>Rămânem aproape</h2>
          <a href="/contact/">Contact & program</a>
          <a href="/sustine/">Susține cu 3,5%</a>
          <p>
            Galați, România
            <br />
            Șah pentru toate generațiile.
          </p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getUTCFullYear()} ACS Smart Galați</span>
        <span>Cu pasiune pentru șah. Și pentru oameni.</span>
        <a href="#">Înapoi sus ↑</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const nav = document.querySelector<HTMLElement>('#main-nav')!;
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          nav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.header-inner')) {
          nav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
