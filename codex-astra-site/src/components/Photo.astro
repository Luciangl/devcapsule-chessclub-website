---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  file: string;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  file,
  alt,
  class: className,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
  eager: true,
});
const photo = images[`../assets/photos/${file}`]?.default;
if (!photo) throw new Error(`Unknown photo: ${file}`);
---

<Image
  src={photo}
  alt={alt}
  class={className}
  widths={[360, 640, 1080]}
  sizes={sizes}
  format="webp"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
