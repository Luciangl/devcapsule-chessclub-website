---
const { title, description, eyebrow = 'ACS SMART GALAȚI' } = Astro.props;
---

<section class="page-head">
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Acasă</a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </div>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <slot />
  </div>
</section>
