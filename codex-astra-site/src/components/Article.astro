---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHead from './PageHead.astro';
import Photo from './Photo.astro';
import { dateLabel } from '../lib/site';
import { isArchived } from '../lib/archive.mjs';
const { entry } = Astro.props as { entry: CollectionEntry<'news'> };
const { Content } = await render(entry);
const archived = isArchived(entry.data.date);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <PageHead
    title={entry.data.title}
    description={entry.data.summary}
    eyebrow={`${archived ? 'DIN ARHIVĂ · ' : ''}${dateLabel(entry.data.date)}`}
  />
  <div class="container page-body article-layout">
    <article>
      <Photo
        file={entry.data.cover_image}
        alt="Fotografie din arhiva clubului ACS Smart Galați"
        class="article-cover"
        eager
      />
      <div class="prose">
        <Content />
      </div>
      {entry.data.photos_album_url && (
        <a
          class="button secondary"
          href={entry.data.photos_album_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Vezi albumul foto {entry.data.photos_count ? `(${entry.data.photos_count})` : ''} ↗
        </a>
      )}
      {entry.data.lichess_study_url && (
        <div class="embed-wrap">
          <iframe
            src={entry.data.lichess_study_url}
            title="Partidă de șah pentru studiu pe Lichess"
            loading="lazy"
          ></iframe>
          <p>
            <a
              class="text-link"
              href={entry.data.lichess_study_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Deschide partida pe Lichess ↗
            </a>
          </p>
        </div>
      )}
      <a class="text-link" href={archived ? '/arhiva/' : '/noutati/'} style="margin-top:30px">
        ← {archived ? 'Înapoi în arhivă' : 'Toate noutățile'}
      </a>
    </article>
    <aside class="aside-card">
      <span class="eyebrow">DIN VIAȚA CLUBULUI</span>
      <h2>Povestea continuă.</h2>
      <p>De la antrenamente la competiții, fiecare întâlnire ne aduce mai aproape.</p>
      <a href="/galerie-foto/">Explorează galeria →</a>
      <a href="/cursuri/">Cursurile noastre →</a>
      <a href="/arhiva/">Arhiva clubului →</a>
    </aside>
  </div>
</Layout>
