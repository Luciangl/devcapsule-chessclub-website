---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
  eager: true,
});
const albums = await Promise.all(
  (await getCollection('galleries'))
    .sort((a, b) => b.data.year - a.data.year)
    .map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const count = albums.reduce((n, a) => n + a.entry.data.photos.length, 0);
---

<Layout title="Galerie foto">
  <PageHead
    title="Împreună se vede mai frumos."
    description="Concentrare, bucurie și prietenii. Amintiri din turneele și cantonamentele ACS Smart Galați."
    eyebrow="ALBUMUL NOSTRU DE FAMILIE"
  />
  <div class="container page-body">
    <div class="filters" aria-label="Filtrează albumele">
      <button class="filter-button" data-album-filter="all" aria-pressed="true">
        Toate albumele
      </button>
      {albums.map(({ entry }) => (
        <button class="filter-button" data-album-filter={entry.id} aria-pressed="false">
          {entry.data.year} · {entry.data.location}
        </button>
      ))}
      <span class="filter-count" aria-live="polite">
        {count} fotografii
      </span>
    </div>
    {albums.map(({ entry, Content }) => (
      <section data-album={entry.id}>
        <div class="album-heading">
          <div>
            <span class="eyebrow">
              {entry.data.year} · {entry.data.location}
            </span>
            <h2>{entry.data.title}</h2>
            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
        <div class="gallery-grid">
          {entry.data.photos.map(async (photo) => {
            const full = await getImage({
              src: images[`../assets/photos/${photo.file}`].default,
              format: 'webp',
              width: 1080,
            });
            return (
              <button
                class="gallery-button"
                data-gallery-src={full.src}
                data-caption={photo.alt}
                aria-label={`Mărește: ${photo.alt}`}
              >
                <Photo file={photo.file} alt={photo.alt} sizes="(max-width:650px) 50vw, 33vw" />
              </button>
            );
          })}
        </div>
        {entry.data.photos_album_url && (
          <a
            class="text-link"
            href={entry.data.photos_album_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Albumul complet{' '}
            {entry.data.photos_count ? `· ${entry.data.photos_count} fotografii` : ''} ↗
          </a>
        )}
      </section>
    ))}
  </div>
  <dialog aria-label="Vizualizator foto">
    <div class="dialog-bar">
      <span id="photo-caption" aria-live="polite"></span>
      <button data-close aria-label="Închide fotografia">
        Închide ✕
      </button>
    </div>
    <img id="full-photo" src="" alt="" />
    <div class="dialog-controls">
      <button data-prev aria-label="Fotografia precedentă">
        ← Înapoi
      </button>
      <span id="photo-count" aria-live="polite"></span>
      <button data-next aria-label="Fotografia următoare">
        Înainte →
      </button>
    </div>
  </dialog>
</Layout>
<script>
  const dialog = document.querySelector('dialog')!;
  const full = document.querySelector<HTMLImageElement>('#full-photo')!;
  const all = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]')];
  let visible = all;
  let active = 0;
  let opener: HTMLButtonElement;
  const show = (index: number) => {
    active = (index + visible.length) % visible.length;
    const button = visible[active];
    full.src = button.dataset.gallerySrc!;
    full.alt = button.dataset.caption!;
    document.querySelector('#photo-caption')!.textContent = full.alt;
    document.querySelector('#photo-count')!.textContent = `${active + 1} / ${visible.length}`;
  };
  all.forEach((button) =>
    button.addEventListener('click', () => {
      opener = button;
      visible = all.filter((b) => !b.closest<HTMLElement>('[data-album]')!.hidden);
      show(visible.indexOf(button));
      dialog.showModal();
    }),
  );
  document.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  document.querySelector('[data-prev]')!.addEventListener('click', () => show(active - 1));
  document.querySelector('[data-next]')!.addEventListener('click', () => show(active + 1));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      show(active - 1);
    }
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      show(active + 1);
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => opener?.focus());
  document.querySelectorAll<HTMLButtonElement>('[data-album-filter]').forEach((button) =>
    button.addEventListener('click', () => {
      document
        .querySelectorAll('[data-album-filter]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document
        .querySelectorAll<HTMLElement>('[data-album]')
        .forEach(
          (album) =>
            (album.hidden =
              button.dataset.albumFilter !== 'all' &&
              album.dataset.album !== button.dataset.albumFilter),
        );
      const count = all.filter((b) => !b.closest<HTMLElement>('[data-album]')!.hidden).length;
      document.querySelector('.filter-count')!.textContent = `${count} fotografii`;
    }),
  );
</script>
