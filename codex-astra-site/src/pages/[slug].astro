---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import ContactReveal from '../components/ContactReveal.astro';
import Photo from '../components/Photo.astro';
import { site } from '../lib/site';
export async function getStaticPaths() {
  return (await getCollection('pages')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <PageHead title={entry.data.title} description={entry.data.subtitle} />
  <div class="container page-body article-layout">
    <article>
      {entry.id === 'despre-noi' && (
        <Photo
          file="photo_56.jpg"
          alt="Antrenament de șah în cantonamentul de la Bran"
          class="article-cover"
          eager
        />
      )}
      <div class="prose">
        <Content />
      </div>
      {['contact', 'sustine'].includes(entry.id) && <ContactReveal />}
      {entry.id === 'contact' && (
        <a
          class="text-link"
          href="https://www.google.com/maps/search/?api=1&query=ACS+Smart+Galati"
          target="_blank"
          rel="noopener noreferrer"
        >
          Caută clubul pe Google Maps ↗
        </a>
      )}
    </article>
    <aside class="aside-card">
      <span class="eyebrow">ÎMPREUNĂ, MUTARE CU MUTARE</span>
      <h2>Hai să ne cunoaștem.</h2>
      <p>Începător sau jucător cu experiență? Găsim împreună locul potrivit pentru tine.</p>
      <a class="button" href={site.enrollmentUrl}>
        Înscrie-te la cursuri <span aria-hidden="true">↗</span>
      </a>
      <a href="/antrenori/">Cunoaște antrenorii →</a>
      <a href="/echipe/">Echipele clubului →</a>
      <a href="/performante/">Performanțele noastre →</a>
      <a href="/contact/">Contact & program →</a>
    </aside>
  </div>
</Layout>
