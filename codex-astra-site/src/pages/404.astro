---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagină negăsită">
  <section class="container page-body">
    <span class="eyebrow">404 · O MUTARE ÎN AFARA TABLEI</span>
    <h1 style="font-size:clamp(35px,6vw,70px);margin:30px 0">Hai să revenim în joc.</h1>
    <p>Pagina căutată nu există sau a fost mutată în arhivă.</p>
    <div class="hero-actions">
      <a class="button" href="/">
        Înapoi acasă →
      </a>
      <a class="text-link" href="/arhiva/">
        Caută în arhivă ↗
      </a>
    </div>
  </section>
</Layout>
