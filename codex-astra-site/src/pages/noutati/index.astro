---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { isArchived } from '../../lib/archive.mjs';
const news = (await getCollection('news'))
  .filter((n) => !isArchived(n.data.date))
  .sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(news.flatMap((n) => n.data.tags))];
---

<Layout title="Noutăți">
  <PageHead
    title="Povești de la masa de joc."
    description="Turnee, antrenamente și momente pe care le trăim împreună. Noutățile ultimilor doi ani, din viața ACS Smart Galați."
    eyebrow="JURNALUL CLUBULUI"
  />
  <section class="container page-body">
    <div class="filters" aria-label="Filtrează noutățile">
      <button class="filter-button" data-tag="all" aria-pressed="true">
        Toate
      </button>
      {tags.map((tag) => (
        <button class="filter-button" data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
      <span class="filter-count" aria-live="polite">
        {news.length} articole
      </span>
    </div>
    <div class="news-grid">
      {news.map((entry) => (
        <div data-news-tags={entry.data.tags.join(' ')}>
          <NewsCard entry={entry} />
        </div>
      ))}
    </div>
    {!news.length && (
      <p class="empty-state">
        Nu sunt articole din ultimii doi ani. Descoperă poveștile clubului în arhivă.
      </p>
    )}
    <a class="text-link" style="margin-top:40px" href="/arhiva/">
      Arhivă turnee & știri <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((button) =>
    button.addEventListener('click', () => {
      const tag = button.dataset.tag;
      document
        .querySelectorAll('[data-tag]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-news-tags]').forEach((item) => {
        item.hidden = tag !== 'all' && !item.dataset.newsTags!.split(' ').includes(tag!);
        if (!item.hidden) count++;
      });
      document.querySelector('.filter-count')!.textContent = `${count} articole`;
    }),
  );
</script>
