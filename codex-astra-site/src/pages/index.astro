---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import NewsCard from '../components/NewsCard.astro';
import { isArchived } from '../lib/archive.mjs';
import { site } from '../lib/site';
const home = (await getEntry('home', 'prima-pagina'))!;
const { Content } = await render(home);
const news = (await getCollection('news'))
  .filter((n) => !isArchived(n.data.date))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
const programs = [
  {
    piece: '♙',
    level: 'PRIMELE MUTĂRI',
    title: 'Curiozitatea devine pasiune.',
    text: 'Descoperim piesele, învățăm regulile și facem loc imaginației. Un început prietenos pentru micii exploratori.',
    link: 'Descoperă cursurile de inițiere',
    anchor: 'initiere',
  },
  {
    piece: '♘',
    level: 'URMĂTORUL NIVEL',
    title: 'Fiecare mutare contează.',
    text: 'Construim strategii, descoperim combinații și învățăm din fiecare partidă. Cu răbdare, alături de antrenori.',
    link: 'Explorează grupa intermediară',
    anchor: 'intermediari',
  },
  {
    piece: '♜',
    level: 'SPRE PERFORMANȚĂ',
    title: 'Ambiție. Antrenament. Podium.',
    text: 'Pregătire dedicată, turnee și spirit de echipă. Pentru cei care vor să-și ducă pasiunea mai departe.',
    link: 'Cunoaște lotul competițional',
    anchor: 'performanta',
  },
];
---

<Layout>
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow with-dot">{home.data.eyebrow}</span>
        <h1>
          {home.data.title.slice(0, home.data.title.lastIndexOf(' '))}{' '}
          <em>{home.data.title.split(' ').at(-1)}</em>
        </h1>
        <p>{home.data.lead}</p>
        <div class="hero-actions">
          <a class="button" href={site.enrollmentUrl}>
            Hai la prima mutare <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/despre-noi/">
            Descoperă clubul <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-note">
          <span class="small-pieces" aria-hidden="true">
            ♙♘♗
          </span>
          <span>Minți curioase. Prietenii adevărate. Din 2014.</span>
        </div>
      </div>
      <div class="hero-visual">
        <Photo
          file="photo_56.jpg"
          alt="Copiii și antrenorii ACS Smart Galați la mesele de șah în cantonamentul de la Bran"
          class="hero-photo"
          eager
        />
        <div class="hero-badge">
          <span>MAI MULT</span>
          <strong>decât șah.</strong>
          <span>DIN 2014</span>
        </div>
        <span class="image-caption">Împreună, la cantonamentul din Bran · 2024</span>
        <div class="move-card">
          <span aria-hidden="true">♘</span>
          <div>
            <small>O LECȚIE PENTRU VIAȚĂ</small>
            <strong>Gândește. Mută. Crește.</strong>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="container stats">
    <div class="stat">
      <strong>2014</strong>
      <span>
        Începutul
        <br />
        poveștii noastre
      </span>
    </div>
    <div class="stat">
      <strong>6</strong>
      <span>
        Antrenori & instructori
        <br />
        alături de tine
      </span>
    </div>
    <div class="stat">
      <strong>3</strong>
      <span>
        Niveluri de pregătire
        <br />
        pentru orice început
      </span>
    </div>
    <div class="stat">
      <strong>∞</strong>
      <span>
        Posibilități de a crește
        <br />
        mutare cu mutare
      </span>
    </div>
  </div>
  <section class="container section">
    <div class="section-top">
      <div>
        <span class="eyebrow">FIECARE CAMPION A FOST CÂNDVA ÎNCEPĂTOR</span>
        <h2>Tu unde începi?</h2>
      </div>
      <p>Nu contează câte mutări știi. Contează curiozitatea de a o descoperi pe următoarea.</p>
    </div>
    <div class="programs">
      {programs.map((p) => (
        <article class="program">
          <div class="program-top">
            <span class="piece" aria-hidden="true">
              {p.piece}
            </span>
            <span class="level">{p.level}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <a href={`/cursuri/#${p.anchor}`}>
            {p.link}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="story-section">
    <div class="container story-grid">
      <Photo
        file="photo_60.jpg"
        alt="O amintire din cantonamentul clubului la Bran, în 2024"
        class="story-photo"
      />
      <div class="story-copy">
        <span class="eyebrow">POVESTEA NOASTRĂ</span>
        <h2>
          Un sport al minții.
          <br />
          Un loc al prieteniei.
        </h2>
        <Content />
        <a class="text-link" href="/despre-noi/">
          Oamenii din spatele mutărilor <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-top">
      <div>
        <span class="eyebrow">VIAȚA CLUBULUI</span>
        <h2>Dincolo de tabla de șah.</h2>
      </div>
      <a class="text-link" href="/noutati/">
        Toate noutățile <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="news-grid">
      {news.map((entry) => (
        <NewsCard entry={entry} />
      ))}
    </div>
    {!news.length && (
      <p class="empty-state">
        Poveștile clubului te așteaptă în <a href="/arhiva/">arhivă →</a>.
      </p>
    )}
  </section>
  <div class="container chess-strip">
    <span class="chess-icon" aria-hidden="true">
      ♘
    </span>
    <div>
      <h2>Ai câteva minute pentru o mutare bună?</h2>
      <p>Exersează, explorează o partidă și lasă curiozitatea să te conducă.</p>
    </div>
    <a class="text-link" href="/lichess/">
      Intră în colțul de șah <span aria-hidden="true">↗</span>
    </a>
  </div>
</Layout>
