---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { isArchived, articleUrl } from '../../lib/archive.mjs';
import { dateLabel } from '../../lib/site';
const news = (await getCollection('news'))
  .filter((n) => isArchived(n.data.date))
  .sort((a, b) => +b.data.date - +a.data.date);
const years = [...new Set(news.map((n) => n.data.date.getUTCFullYear()))];
---

<Layout title="Arhiva clubului">
  <PageHead
    title="Mutări care au devenit amintiri."
    description="Poveștile de acum mai bine de doi ani rămân parte din noi. Răsfoiește arhiva cronologică a clubului."
    eyebrow="ARHIVĂ TURNEE & ȘTIRI"
  />
  <section class="container page-body">
    {years.map((year) => (
      <section>
        <h2 class="archive-year">{year}</h2>
        {news
          .filter((n) => n.data.date.getUTCFullYear() === year)
          .map((entry) => (
            <a class="archive-row" href={articleUrl(entry)}>
              <time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>
              <h3>{entry.data.title}</h3>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
      </section>
    ))}
    {!news.length && <p class="empty-state">Arhiva nu conține încă articole.</p>}
    <a class="text-link" href="/noutati/" style="margin-top:35px">
      Înapoi la noutăți →
    </a>
  </section>
</Layout>
