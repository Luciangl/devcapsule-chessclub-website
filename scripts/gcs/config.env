# ==============================================================================
# GCS Deployment Suite Configuration (Environment Variables & Defaults)
#
# ACS Smart Galați Website Deployment
# Target: smartgalati-test2
# Storage Bucket: test2 (Regional Finland europe-north1)
# Resource Project: mycodespace3p
# DNS Project: central-trees-497510-h7
# ==============================================================================

# Core Project ID where Storage, Load Balancer, and Compute resources reside
export PROJECT_ID="${PROJECT_ID:-mycodespace3p}"

# Cloud DNS Project ID and Zone Name
# DNS where the A record needs to be added is under central-trees-497510-h7
export DNS_PROJECT_ID="${DNS_PROJECT_ID:-central-trees-497510-h7}"
export DNS_ZONE="${DNS_ZONE:-mycodespace}"

# Website Domain Configuration
export SUBDOMAIN="${SUBDOMAIN:-smartgalati-test2}"
export PARENT_DOMAIN="${PARENT_DOMAIN:-mycodespace.ai}"
export DOMAIN="${DOMAIN:-${SUBDOMAIN}.${PARENT_DOMAIN}}"

# Google Cloud Storage Configuration
# Bucket name: 'test2' as requested (or test2-${PROJECT_ID} if globally claimed)
export BUCKET_NAME="${BUCKET_NAME:-test2-smartgalati-mycodespace}"
# Storage location regional to Finland (Hamina, Finland)
export LOCATION="${LOCATION:-europe-north1}"
export STORAGE_CLASS="${STORAGE_CLASS:-STANDARD}"

# Source directory inside repository for static website build
export SITE_DIR="${SITE_DIR:-ag-flash3.8-site}"

# Load Balancer Configuration:
# - LB_PROJECT_ID: The GCP project hosting the Load Balancer (defaults to PROJECT_ID for new LB,
#   or can point to another project such as central-trees-497510-h7 when adding to an existing LB!)
export LB_PROJECT_ID="${LB_PROJECT_ID:-${PROJECT_ID}}"

# Name prefix for a new Load Balancer (used by 04-setup-https-loadbalancer.sh)
export LB_NAME_PREFIX="${LB_NAME_PREFIX:-chessclub-test2}"

# Existing Load Balancer Name (used by 04b-add-to-existing-loadbalancer.sh)
export EXISTING_LB_NAME="${EXISTING_LB_NAME:-chessclub-site}"

# Execution mode: 'create' for new Load Balancer, 'existing' for attaching to existing Load Balancer
export LB_MODE="${LB_MODE:-create}"
