<div class="flex items-center gap-2">
  <label for="theme-select" class="sr-only">Alege tema (Culoare)</label>
  <select
    id="theme-select"
    class="bg-bg-base border border-border-base text-text-base text-sm rounded px-2 py-1 focus:ring-2 focus:ring-focus focus:border-focus focus:outline-none cursor-pointer"
  >
    <option value="default">Implicit (Deschis)</option>
    <option value="dark">Întunecat</option>
    <option value="solarized-light">Solarized Light</option>
    <option value="nord">Nord</option>
    <option value="sepia">Sepia</option>
  </select>
</div>

<script>
  const select = document.getElementById('theme-select') as HTMLSelectElement;
  
  // Set initial value from current data-theme
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'default';
  if (select) {
    select.value = currentTheme;
    
    select.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const theme = target.value;
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('theme', theme);
      } catch (err) {
        // Ignore storage errors if blocked
      }
    });
  }
</script>
