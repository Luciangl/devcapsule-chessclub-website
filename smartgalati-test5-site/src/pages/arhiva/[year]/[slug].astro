---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { newsCover } from '../../../lib/images';

export async function getStaticPaths() {
  const news = await getCollection('news');
  const currentYear = new Date().getFullYear();
  const archived = news.filter(n => n.data.date.getFullYear() < currentYear - 2);
  
  return archived.map(n => ({
    params: { year: n.data.date.getFullYear().toString(), slug: n.id },
    props: { newsItem: n },
  }));
}

const { newsItem } = Astro.props;
const { Content } = await render(newsItem);
---

<Layout title={`${newsItem.data.title} (Arhivă)`} description={newsItem.data.summary}>
    <article class="max-w-4xl mx-auto py-8">
        <div class="bg-bg-accent text-text-muted px-4 py-2 rounded-lg mb-6 flex items-center justify-between">
            <span>Acest articol face parte din arhiva clubului ({newsItem.data.date.getFullYear()}).</span>
            <a href="/arhiva" class="text-primary hover:underline font-medium">Înapoi la arhivă</a>
        </div>
        
        <header class="mb-8 border-b border-border-base pb-8">
            <h1 class="text-4xl font-bold text-primary mb-4">{newsItem.data.title}</h1>
            <div class="flex items-center gap-4 text-text-muted">
                <time datetime={newsItem.data.date.toISOString()}>
                    {newsItem.data.date.toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span class="px-3 py-1 bg-bg-subtle border border-border-base rounded-full text-sm font-medium">{newsItem.data.category}</span>
            </div>
            {newsItem.data.cover_image && newsCover(newsItem.data.cover_image) && (
                <Image src={newsCover(newsItem.data.cover_image)!} alt="" class="w-full h-64 md:h-96 object-cover rounded-xl mt-6 opacity-90" />
            )}
        </header>
        
        <div class="prose prose-lg dark:prose-invert max-w-none prose-a:text-focus prose-headings:text-primary prose-img:rounded-xl opacity-90">
            <Content />
        </div>
        
        {newsItem.data.source_url && (
            <div class="mt-12 text-sm text-text-muted pt-4 border-t border-border-base">
                Sursa originală: <a href={newsItem.data.source_url} target="_blank" rel="noopener noreferrer" class="hover:text-primary underline">{newsItem.data.source_url}</a>
            </div>
        )}
    </article>
</Layout>
