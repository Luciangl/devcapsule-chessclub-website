---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const news = await getCollection('news');
const currentYear = new Date().getFullYear();
const recent = news.filter(n => n.data.date.getFullYear() >= currentYear - 2);

recent.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Noutăți" description="Ultimele știri și noutăți de la ACS Smart Galați">
    <div class="max-w-6xl mx-auto py-8">
        <div class="flex flex-wrap justify-between items-end mb-8 border-b border-border-base pb-4">
            <h1 class="text-4xl font-bold text-primary">Noutăți</h1>
            <a href="/arhiva" class="text-primary hover:underline font-medium">Vezi arhiva ({currentYear - 3} și mai vechi)</a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recent.map((n) => (
                <a href={`/noutati/${n.id}`} class="group flex flex-col bg-bg-base border border-border-base rounded-xl overflow-hidden hover:border-focus hover:shadow-md transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-focus">
                    {n.data.cover_image ? (
                        <img src={n.data.cover_image} alt="" class="w-full h-48 object-cover group-hover:opacity-90 transition-opacity" />
                    ) : (
                        <div class="w-full h-48 bg-bg-subtle flex items-center justify-center text-primary text-6xl group-hover:bg-bg-accent transition-colors">
                            ♟️
                        </div>
                    )}
                    <div class="p-6 flex-grow flex flex-col">
                        <div class="flex items-center gap-3 text-sm text-text-muted mb-3">
                            <time datetime={n.data.date.toISOString()}>
                                {n.data.date.toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </time>
                            <span class="px-2 py-0.5 bg-bg-accent rounded text-xs">{n.data.category}</span>
                        </div>
                        <h2 class="text-xl font-bold text-text-base mb-2 group-hover:text-primary transition-colors">{n.data.title}</h2>
                        <p class="text-text-muted text-sm line-clamp-3 mb-4">{n.data.summary}</p>
                        <span class="mt-auto text-primary font-medium group-hover:underline">Citește mai mult &rarr;</span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</Layout>
