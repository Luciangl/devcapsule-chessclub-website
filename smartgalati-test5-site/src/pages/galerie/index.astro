---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { photo } from '../../lib/images';

const galleries = await getCollection('galleries');
galleries.sort((a, b) => b.data.year - a.data.year);
---

<Layout title="Galerie Foto" description="Galerie foto ACS Smart Galați">
    <div class="max-w-6xl mx-auto py-8">
        <h1 class="text-4xl font-bold text-primary mb-8 border-b border-border-base pb-4">Galerie Foto</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {galleries.map((g) => (
                <a href={`/galerie/${g.id}`} class="group block bg-bg-base border border-border-base rounded-xl overflow-hidden hover:border-focus transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-focus">
                    <Image src={photo(g.data.cover_image)!} alt="" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300" />
                    <div class="p-4 border-t border-border-base relative bg-bg-base z-10">
                        <div class="flex justify-between items-start mb-2">
                            <h2 class="text-xl font-bold text-text-base group-hover:text-primary transition-colors">{g.data.title}</h2>
                            <span class="px-2 py-1 bg-bg-accent rounded text-xs font-bold text-text-muted">{g.data.year}</span>
                        </div>
                        {g.data.location && <p class="text-sm text-text-muted mb-2">📍 {g.data.location}</p>}
                        
                        <p class="text-sm text-primary font-medium mt-4">
                            {g.data.photos?.length ? `${g.data.photos.length} fotografii` : 'Vezi album extern'} &rarr;
                        </p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</Layout>
