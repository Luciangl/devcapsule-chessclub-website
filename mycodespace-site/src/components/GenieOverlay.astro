</div>

<style>
  .genie-overlay[hidden], .genie-replay[hidden] { display: none !important; }
  .genie-overlay { position: fixed; inset: 0; z-index: 30; pointer-events: none; overflow: hidden; }
  .genie-flight { position: absolute; left: 50%; top: 50%; width: min(900px, 92vw); transform: translate(-50%, -50%); }
  .genie-scene { display: block; width: 100%; height: auto; overflow: visible; }
  .genie-drawing { filter: drop-shadow(1px 0 0 var(--paper)) drop-shadow(-1px 0 0 var(--paper)) drop-shadow(0 1px 0 var(--paper)) drop-shadow(0 -1px 0 var(--paper)); }
  .genie-bubble-text { fill: var(--blue); stroke: var(--paper); stroke-width: 6px; paint-order: stroke fill; font: 25px Arial, sans-serif; letter-spacing: -.5px; }
  .genie-final-lead { font-size: 31px; }
  .genie-brand { font: italic 48px Georgia, serif; letter-spacing: -1.5px; }
  .genie-joke, .genie-smoke, .genie-announcement, .genie-wink, .genie-sparks { opacity: 0; }
  .genie-dismiss { position: absolute; top: 72px; right: max(24px, calc((100vw - 1080px) / 2)); pointer-events: auto; font: 13px Arial, sans-serif; color: var(--blue); background: var(--paper); border: 1px solid var(--line); border-radius: 3px; padding: 8px 12px; cursor: pointer; }
  .genie-dismiss span { font-size: 18px; margin-left: 12px; }
  .genie-replay { display: block; margin: 0 0 24px auto; background: none; border: 0; padding: 8px 0; color: var(--muted); font: 12px Arial, sans-serif; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .genie-dismiss:focus-visible, .genie-replay:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .playing .genie-flight { animation: genie-arrive 1.6s cubic-bezier(.16,.7,.23,1) both; }
  .playing .genie-brow { transform-origin: 365px 225px; animation: genie-brow .65s 1.7s ease-in-out both; }
  .playing .genie-open-eye { animation: genie-eye .55s 2.25s linear both; }
  .playing .genie-wink { animation: genie-show .55s 2.25s linear both; }
  .playing .genie-joke { animation: genie-show 2.3s 2.6s ease both; }
  .playing .genie-rubbing-hand { transform-origin: 450px 365px; animation: genie-rub .25s 4.9s ease-in-out 5 alternate; }
  .playing .genie-sparks { animation: genie-show 1.2s 4.9s ease both; }
  .playing .genie-smoke { transform-origin: 400px 390px; animation: genie-poof 1.1s 6.15s ease-out both; }
  .playing .genie-character { animation: genie-vanish .4s 6.3s ease both; }
  .playing .genie-announcement { transform-origin: 458px 300px; animation: genie-reveal 3.1s 6.65s ease both; }
  @keyframes genie-arrive { from { transform: translate(calc(-50vw + 24px), calc(50vh - 110px)) scale(.12); opacity: 0; } 12% { opacity: 1; } to { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
  @keyframes genie-brow { 0%, 100% { transform: translateY(0) rotate(0); } 40%, 70% { transform: translateY(-8px) rotate(-12deg); } }
  @keyframes genie-eye { 0%, 100% { opacity: 1; } 15%, 85% { opacity: 0; } }
  @keyframes genie-show { 0%, 100% { opacity: 0; } 12%, 88% { opacity: 1; } }
  @keyframes genie-rub { from { transform: translate(-3px, 2px) rotate(-3deg); } to { transform: translate(7px, -4px) rotate(3deg); } }
  @keyframes genie-poof { 0% { transform: scale(.15); opacity: 0; } 23% { opacity: 1; } 65% { opacity: .9; } 100% { transform: scale(1.7) rotate(8deg); opacity: 0; } }
  @keyframes genie-vanish { to { opacity: 0; transform: translateY(-12px); } }
  @keyframes genie-reveal { 0% { opacity: 0; transform: scale(.87); } 12%, 88% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.04); } }
  @media (max-width: 950px), (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) { .genie-overlay, .genie-replay { display: none !important; } }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>('.genie-overlay');
  const replay = document.querySelector<HTMLButtonElement>('.genie-replay');
  const dismiss = overlay?.querySelector<HTMLButtonElement>('.genie-dismiss');
  const eligible = window.matchMedia('(min-width: 951px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  const sessionKey = 'mycodespace-genie-fresh-v1';
  let finishTimer: ReturnType<typeof setTimeout>;
  let startTimer: ReturnType<typeof setTimeout>;
  function stop() {
    clearTimeout(finishTimer);
    clearTimeout(startTimer);
    if (!overlay) return;
    const hadFocus = overlay.contains(document.activeElement);
    overlay.hidden = true;
    overlay.classList.remove('playing');
    if (hadFocus && eligible.matches) replay?.focus({ preventScroll: true });
  }
  function play() {
    stop();
    if (!eligible.matches || !overlay) return;
    overlay.hidden = false;
    void overlay.offsetWidth;
    overlay.classList.add('playing');
    try { sessionStorage.setItem(sessionKey, 'seen'); } catch { /* Storage is optional. */ }
    finishTimer = setTimeout(stop, 10000);
  }
  function eligibilityChanged() {
    if (replay) replay.hidden = !eligible.matches;
    if (!eligible.matches) stop();
  }
  eligibilityChanged();
  eligible.addEventListener('change', eligibilityChanged);
  replay?.addEventListener('click', play);
  dismiss?.addEventListener('click', stop);
  document.addEventListener('keydown', event => { if (event.key === 'Escape') stop(); });
  let seen = false;
  try { seen = sessionStorage.getItem(sessionKey) === 'seen'; } catch { /* Still allow playback. */ }
  if (eligible.matches && (!seen || new URLSearchParams(location.search).get('genie') === '1')) {
    startTimer = setTimeout(play, 600);
  }
</script>
