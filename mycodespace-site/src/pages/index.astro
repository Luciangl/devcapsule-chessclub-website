---
import "../styles/global.css";
const description =
  "Keep your code, the tools to run it, and the knowledge behind it. DevCapsule is the first product from MyCodeSpace, with more to follow.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MyCodeSpace — A project worth coming back to</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="canonical" href="https://mycodespace.ai/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="MyCodeSpace — A project worth coming back to"
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://mycodespace.ai/" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="MyCodeSpace home">
          <span class="mark" aria-hidden="true">
            m<span>c</span>
          </span>
          mycodespace<span class="domain">.ai</span>
        </a>
        <a class="header-link" href="https://devcapsule.mycodespace.ai/">
          Meet DevCapsule <span aria-hidden="true">↗</span>
        </a>
      </header>
      <main id="main">
        <section class="intro" aria-labelledby="intro-title">
          <p class="eyebrow">
            <span class="small-line" aria-hidden="true"></span> A project worth
            coming back to
          </p>
          <h1 id="intro-title">
            Your code should
            <br />
            outlast your <em>computer.</em>
          </h1>
          <p class="lead">
            Think of a program you wrote years ago.
            <br class="wide-break" /> Could you still build it? Run it? Pick up
            where you left off?
          </p>
          <div class="idea">
            <p>
              Keeping the source is only part of it. The tools change, the old
              machine goes, and the reasons behind your decisions get forgotten.
            </p>
            <p>
              MyCodeSpace is about keeping those things together: your code, a
              working environment, and the knowledge behind the project. So
              coming back to it doesn’t mean starting over.
            </p>
          </div>
        </section>
        <section class="product" aria-labelledby="product-title">
          <div class="product-note">
            <span class="product-number">01</span>
            <p>Our first product</p>
          </div>
          <div class="product-body">
            <div class="product-heading">
              <h2 id="product-title">
                DevCapsule<span aria-hidden="true">.</span>
              </h2>
              <span class="badge">Available now</span>
            </div>
            <p>
              A real IDE and your choice of coding agent, in a workspace you can
              close and come back to. Your tools, settings, and project
              knowledge stay with you.
            </p>
            <a class="button" href="https://devcapsule.mycodespace.ai/">
              Explore DevCapsule <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
        <aside class="next">
          <p>
            We’re starting with DevCapsule.
            <br />
            <strong>There’s more to follow.</strong>
          </p>
          <a href="https://lnkd.in/p/dJNtaetF">
            The idea behind MyCodeSpace <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </main>
      <footer>
        <span>MyCodeSpace</span>
        <span>Code you can come back to.</span>
      </footer>
    </div>
  </body>
</html>
